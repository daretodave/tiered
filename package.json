{
  "name": "tiered",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm tokens && next build",
    "start": "next start -p 4173",
    "tokens": "node scripts/tokens-to-css.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "pnpm --dir apps/e2e exec playwright test",
    "e2e:install": "pnpm --dir apps/e2e install && pnpm --dir apps/e2e exec playwright install --with-deps chromium",
    "e2e:ui": "pnpm --dir apps/e2e exec playwright test --ui",
    "e2e:full": "E2E_FULL=1 pnpm --dir apps/e2e exec playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "content:quota": "node scripts/content-quota.mjs",
    "check:no-raw-img": "node scripts/check-no-raw-img.mjs",
    "check:test-colocation": "node scripts/check-test-colocation.mjs",
    "size": "node scripts/size.mjs",
    "verify": "pnpm tokens && pnpm typecheck && pnpm check:no-raw-img && pnpm check:test-colocation && pnpm test:run && pnpm test:scripts && pnpm content:check && pnpm build && pnpm e2e",
    "deploy:check": "node scripts/deploy-check.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^1.3.1",
    "gray-matter": "^4.0.3",
    "next": "^15.5.28",
    "openai": "^6.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@panva/hkdf": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "jose": "^6.2.13",
    "jsdom": "^25.0.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild@<0.28.1": "^0.28.1",
      "vite@<7.3.7": "^7.3.7"
    }
  }
}
